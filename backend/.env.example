# ---------------------------------------------------------------------
# CampusBite AI — Environment Variables
# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------

# --- Application ---------------------------------------------------------
PROJECT_NAME="CampusBite AI"
ENVIRONMENT=local
DEBUG=true

# --- Security --------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated list, e.g. http://localhost:5173) -------------
BACKEND_CORS_ORIGINS=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=campusbite
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=campusbite
# Optional: overrides the assembled URL above if set
# DATABASE_URL=postgresql+asyncpg://campusbite:campusbite@db:5432/campusbite

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional: overrides the assembled URL above if set
# REDIS_URL=redis://redis:6379/0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- WhatsApp Cloud API (wired in a future milestone) -----------------------
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- LLM Providers (wired in a future milestone) ----------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
